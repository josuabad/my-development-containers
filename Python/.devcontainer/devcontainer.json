{
    "name": "Python 3.14 Development Environment",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "python-app",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-toolsai.jupyter",
                "esbenp.prettier-vscode",
                "redhat.vscode-yaml"
            ]
        }
    }
}